{
  "name": "dtrw-app-helloworld",
  "version": "2.4.0",
  "repository": "git@github.com:burtek/dtrw-app-helloworld.git",
  "author": "Bartosz <burtekdotryw@gmail.com>",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "catalog:",
    "commit-and-tag-version": "^13.1.0",
    "cpx2": "catalog:",
    "husky": "^9.1.7",
    "rimraf": "^6.1.3",
    "vitest": "catalog:"
  },
  "scripts": {
    "check-all": "pnpm run validate && pnpm -r --parallel --aggregate-output --no-bail run '/^(lint|typecheck|test)$/'",
    "dev": "pnpm run validate && pnpm -r --parallel run /^dev/",
    "prebuild": "pnpm run validate",
    "build": "pnpm -r --parallel --aggregate-output --no-bail run build",
    "predeploy": "pnpm run validate && pnpm run clear && pnpm run build",
    "deploy": "pnpm -r --parallel --aggregate-output --no-bail run deploy",
    "postdeploy": "node scripts/collect-deployables.mjs",
    "lint": "pnpm -r --parallel --aggregate-output --no-bail run lint",
    "typecheck": "pnpm -r --parallel --aggregate-output --no-bail run typecheck",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:playwright": "playwright test",
    "test:all": "pnpm --parallel --aggregate-output --no-bail run /^test(:playwright)?$/",
    "prepare": "husky",
    "prerelease": "pnpm run check-all",
    "release": "commit-and-tag-version",
    "clear": "rimraf dist-* packages/*/dist packages/*/.dist-deployable playwright-report test-results",
    "validate": "node scripts/validate-workspace.mjs"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "engines": {
    "node": "^26.5.0"
  }
}
