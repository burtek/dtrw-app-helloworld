{
  "name": "dtrw-app-helloworld",
  "version": "1.0.0",
  "repository": "git@github.com:burtek/dtrw-app-helloworld.git",
  "author": "Bartosz <burtekdotryw@gmail.com>",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "commit-and-tag-version": "^12.7.3",
    "cpx": "^1.5.0",
    "husky": "^9.1.7",
    "rimraf": "^6.1.3",
    "vitest": "catalog:"
  },
  "scripts": {
    "check-all": "pnpm -r --parallel --aggregate-output --no-bail '/^(lint|typecheck)$/' && pnpm test",
    "dev": "pnpm -r --parallel /^dev/",
    "build": "pnpm -r --parallel --aggregate-output --no-bail build",
    "deploy": "pnpm -F . --parallel --aggregate-output --no-bail /^deploy:/",
    "lint": "pnpm -r --parallel --aggregate-output --no-bail lint",
    "typecheck": "pnpm -r --parallel --aggregate-output --no-bail typecheck",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prepare": "husky",
    "prerelease": "pnpm check-all",
    "release": "commit-and-tag-version",
    "predeploy:backend": "rimraf dist-backend",
    "deploy:backend": "pnpm --filter=backend build && pnpm pm --filter=backend --prod deploy dist-backend",
    "predeploy:frontend": "rimraf dist-frontend",
    "deploy:frontend": "pnpm --filter=frontend build && cpx \"packages/frontend/dist/**/*\" dist-frontend",
    "clear": "rimraf dist-backend dist-frontend packages/*/dist"
  },
  "commit-and-tag-version": {
    "packageFiles": [
      "package.json"
    ],
    "bumpFiles": [
      "package.json",
      "packages/backend/package.json",
      "packages/frontend/package.json"
    ]
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25",
  "engines": {
    "node": "^26.5.0"
  }
}
