{
  "name": "dtrw-app-helloworld",
  "version": "2.8.1",
  "repository": "git@github.com:burtek/dtrw-app-helloworld.git",
  "author": "Bartosz <burtekdotryw@gmail.com>",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "1.64.1",
    "@types/node": "catalog:",
    "commit-and-tag-version": "^13.1.0",
    "husky": "^9.1.7",
    "js-yaml": "^5.4.2",
    "rimraf": "^6.1.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "check-all": "pnpm run validate && pnpm -r --parallel --aggregate-output --no-bail run '/^(lint|typecheck|test)$/'",
    "dev": "pnpm run validate && pnpm run parallel /^dev/",
    "prebuild": "pnpm run validate",
    "build": "pnpm -r --parallel --aggregate-output --no-bail run build",
    "preassemble": "pnpm run validate && pnpm run clear && pnpm run build",
    "assemble": "pnpm -r --parallel --aggregate-output --no-bail run assemble",
    "lint": "pnpm -r --parallel --aggregate-output --no-bail run lint",
    "typecheck": "pnpm -r --parallel --aggregate-output --no-bail run typecheck",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:playwright": "playwright test",
    "test:all": "pnpm --parallel --aggregate-output --no-bail run /^test(:playwright)?$/",
    "prepare": "husky",
    "prerelease": "pnpm run check-all",
    "release": "commit-and-tag-version",
    "clear": "rimraf packages/*/dist packages/*/.assembled playwright-report test-results",
    "validate": "node scripts/validate-workspace.mjs",
    "parallel": "node scripts/run-in-parallel.mjs"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": "26.12.1",
    "runtime": {
      "name": "node",
      "version": "26.12.0",
      "onFail": "error"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "warn"
    }
  }
}
